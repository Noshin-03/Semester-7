# Copy to .env and adjust. docker-compose.yml reads this file automatically.
POSTGRES_DB=foodapp
POSTGRES_USER=foodapp
POSTGRES_PASSWORD=foodapp
# Host port for PostgreSQL (container port is always 5432).
# Change to 5432 if nothing else on your machine uses it.
POSTGRES_HOST_PORT=5433

# pgAdmin web UI login
PGADMIN_DEFAULT_EMAIL=admin@foodapp.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Restaurant service (container port 8081)
RESTAURANT_PORT=8081
LOG_LEVEL=info

# Order service (container port 8082)
# NOTE: inside Docker this MUST be the compose service name, NOT localhost.
RESTAURANT_URL=http://restaurant-service:8081
RESTAURANT_TIMEOUT_MS=2000
ORDER_PORT=8082

# React admin console
WEB_PORT=8080

# PostgreSQL connection string used by the restaurant service
DATABASE_URL=postgres://foodapp:foodapp@postgres:5432/foodapp
