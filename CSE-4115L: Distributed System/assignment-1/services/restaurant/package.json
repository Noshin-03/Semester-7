{
  "name": "restaurant-service",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only restaurant catalogue service (A1).",
  "main": "dist/index.js",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
